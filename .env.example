# ═══════════════════════════════════════════════════════════════════
# SimpleCard 生产环境变量模板
# ═══════════════════════════════════════════════════════════════════
#
# 使用方法：
#   1. 复制此文件到服务器：scp .env.example user@server:/opt/simplecard/.env
#   2. 编辑 /opt/simplecard/.env，将所有 <...> 占位符替换为真实值
#   3. 此文件可以安全提交到 Git（不含真实密钥）
#
# 本文件同时用于：
#   - Docker Compose YAML 变量引用（如 image: ${API_IMAGE}）
#   - env_file 注入到 api 容器内（Spring Boot 读取 ${DB_URL} 等）
#
# ═══════════════════════════════════════════════════════════════════

# ── 镜像标签 ──────────────────────────────────────────────────────
# CI/CD 每次部署会自动更新这两行，无需手动设置。
# 首次部署前可以留空或注释掉。
# API_IMAGE=ghcr.io/<OWNER>/simplecard-api:latest
# WEB_IMAGE=ghcr.io/<OWNER>/simplecard-web:latest

# ── 数据库 ────────────────────────────────────────────────────────
# 必须修改：替换为你的 PostgreSQL 连接信息
#
# 示例：
#   DB_URL=jdbc:postgresql://db.example.com:5432/simplecard
#   DB_USERNAME=simplecard
#   DB_PASSWORD=MyStr0ngP@ssw0rd
#
DB_URL=jdbc:postgresql://<DB_HOST>:5432/<DB_NAME>
DB_USERNAME=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>

# ── JWT 密钥 ──────────────────────────────────────────────────────
# 必须修改：用于签发和验证用户登录 Token 的对称加密密钥
#
# 生成方法（在服务器上执行）：
#   openssl rand -base64 48
#
# 安全要求：
#   - 至少 64 字符的随机字符串
#   - 开发环境和生产环境 必须使用不同的密钥
#   - 泄露此密钥 = 所有用户登录 Token 可被伪造（包括管理员）
#
JWT_SECRET=<用 openssl rand -base64 48 生成并粘贴到这里>

# ── 密码存储模式 ──────────────────────────────────────────────────
# true = 明文存储密码（仅开发调试用，切勿用于生产）
# false = BCrypt 哈希加密存储（生产标准，默认值）
PASSWORD_PLAIN=false

# ── 文件上传路径 ──────────────────────────────────────────────────
# 无需修改（容器内路径，与 docker-compose.yml 的 volumes 挂载对应）
UPLOAD_PATH=/app/uploads

# ── 邮件发送（可选，配置后启用发货邮件通知与访客订单找回）──
# 用途：1) 订单发货后把卡密发到买家邮箱  2) 换设备后凭邮箱验证码找回访客订单
#
# 【先搞清楚一件事】这里配的是「发件人账号」，你和所有收件用户只需要配这一次；
#   用户为了收验证码不需要在邮箱里做任何设置。
#
# 【不要用个人邮箱上线】QQ/163 个人邮箱有日发信上限、无自有域名、共享 IP 信誉差，
#   只适合本地测试（可配合 Mailpit）。正式对外请用事务性邮件服务 + 自有域名，
#   并配置 SPF/DKIM/DMARC。完整选型与上线清单见 docs/email-delivery.md
#
# 配置说明：
#   1. 在服务商后台创建发信账号，获取 SMTP 地址与密码/授权码
#   2. 将 MAIL_ENABLED 改为 true，填入 MAIL_HOST / MAIL_USERNAME / MAIL_PASSWORD
#   3. 未配置时默认关闭（MAIL_ENABLED=false），不影响下单与发货流程
# 端口与加密：465 用隐式 TLS（默认），587 需把 MAIL_SSL 设为 false 并开启 MAIL_STARTTLS
# 注意：只把 MAIL_ENABLED 改成 true 但 MAIL_HOST/MAIL_PASSWORD 仍为空时，系统会判定
#       "未配置"，邮件功能保持关闭并在启动日志告警——避免去连占位符主机刷错误日志。
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SITE_URL=

# 发件人分离（可选）。两项留空时回退到 MAIL_USERNAME，旧部署升级无需改动。
# 验证码与发货通知用不同地址，可隔离信誉：一类被误标垃圾时不拖累另一类送达。
MAIL_FROM_VERIFY=
MAIL_FROM_ORDER=
# 退信收集地址，写入 Return-Path，与 From 头分离。
# 留空则退信回到发件人；建议填专用地址，便于统计硬退率
MAIL_FROM_BOUNCE=

# 网络超时（毫秒）。不要调大：发信跑在异步线程里，一次 SMTP 卡死会占满线程池，
# 连发货通知一起堵住。
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=10000
MAIL_WRITE_TIMEOUT_MS=10000

# 重试次数与退避（毫秒）。验证码有效期只有几分钟，重试窗口必须远小于它。
MAIL_RETRY_MAX_ATTEMPTS=3
MAIL_RETRY_BACKOFF_MS=200
MAIL_RETRY_MAX_BACKOFF_MS=1000

# ── 多通道路由（可选，生产强烈建议）────────────────────────────
# 国内收件域（QQ/163/企业邮箱）走国内服务商，海外域（Gmail/Outlook）走海外服务商，
# 各自维护发信信誉。不配置时退化为上面的单通道，行为与改造前一致。
# domains 为空表示「兜底通道」，承接未被其他通道命中的所有域。
# 完整示例与选型见 docs/email-delivery.md
# MAIL_CHANNELS_DOMESTIC_HOST=smtp.qcloudmail.com
# MAIL_CHANNELS_DOMESTIC_PORT=465
# MAIL_CHANNELS_DOMESTIC_USERNAME=noreply@mail.your-domain.com
# MAIL_CHANNELS_DOMESTIC_PASSWORD=
# MAIL_CHANNELS_DOMESTIC_DOMAINS=qq.com,foxmail.com,163.com,126.com,sina.com,sohu.com
# MAIL_CHANNELS_OVERSEAS_HOST=email-smtp.us-east-1.amazonaws.com
# MAIL_CHANNELS_OVERSEAS_PORT=587
# MAIL_CHANNELS_OVERSEAS_STARTTLS=true
# MAIL_CHANNELS_OVERSEAS_SSL=false
# MAIL_CHANNELS_OVERSEAS_USERNAME=
# MAIL_CHANNELS_OVERSEAS_PASSWORD=
# 显式指定兜底通道；留空则自动推断（优先选 domains 为空的通道）
# MAIL_DEFAULT_CHANNEL=

# ── 访客订单找回（依赖上面的 SMTP）──────────────────────────────
# 用途：用户换设备后，输入下单邮箱 + 邮件验证码，可查看该邮箱下的访客订单与卡密
# 边界：仅限访客订单（未登录下单）；注册账号的订单仍必须登录本人账号查看
# 关闭方法：MAIL_VERIFICATION_ENABLED=false（不影响发货邮件）
MAIL_VERIFICATION_ENABLED=true
# 验证码有效期（秒）/ 同邮箱重发间隔（秒）/ 单码最大尝试次数
MAIL_VERIFICATION_CODE_TTL=600
MAIL_VERIFICATION_RESEND_INTERVAL=60
MAIL_VERIFICATION_MAX_ATTEMPTS=5
# 验证通过后签发的查单凭证有效期（秒），默认 2 小时
MAIL_VERIFICATION_GRANT_TTL=7200

# ── Turnstile 人机验证（推荐）──────────────────────────────────
# 用途：对下单、登录、注册等敏感接口进行无感人机验证，防御脚本攻击
# 获取方式：Cloudflare Dashboard → Turnstile → Add site
# 不配置时自动降级：后端跳过人机验证，设备指纹限流仍生效
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# ── 镜像标签 ──
# 默认拉公开发布的最新版本；生产环境建议固定具体版本号（如 :v1.0.0）便于回滚
# CI/CD 部署时会自动覆盖为本次构建的具体 sha tag
API_IMAGE=ghcr.io/runtimepoet/simplecard-api:latest
WEB_IMAGE=ghcr.io/runtimepoet/simplecard-web:latest
# Redis distributed coordination (required by the API by default)
REDIS_COORDINATION_ENABLED=true
REDIS_ADDRESS=redis://redis:6379
REDIS_PASSWORD=replace_with_a_long_random_password
REDIS_LOCK_PREFIX=simplecard
REDIS_LOCK_WAIT_MS=200
REDIS_LOCK_WATCHDOG_MS=30000

# Independent public-product cache; do not point this at the order-lock Redis.
PRODUCT_GUARD_ENABLED=true
PRODUCT_CACHE_REDIS_ADDRESS=redis://product-cache:6379
PRODUCT_CACHE_REDIS_PASSWORD=replace_with_another_long_random_password
PRODUCT_GUARD_PREFIX=simplecard:product-guard
PRODUCT_BLOOM_CAPACITY=10000
PRODUCT_BLOOM_FALSE_PROBABILITY=0.001
PRODUCT_GUARD_GLOBAL_RPS=300
PRODUCT_GUARD_IP_RPS=30
PRODUCT_GUARD_DATABASE_RPS=100
PRODUCT_GUARD_FALLBACK_RPS=20
PRODUCT_GUARD_DATABASE_CONCURRENCY=8
PRODUCT_GUARD_MAX_NEGATIVE_ENTRIES=5000
PRODUCT_BLOOM_REBUILD_MS=3600000
PRODUCT_DISPLAY_CACHE_ENABLED=true
PRODUCT_DISPLAY_MAX_ENTRY_BYTES=16384
PRODUCT_DISPLAY_MAX_ENTRIES=2000
PRODUCT_DISPLAY_MAX_BYTES=33554432
PRODUCT_DISPLAY_MEMORY_STOP_RATIO=0.8
PRODUCT_DISPLAY_WAIT_MS=100

# Independent API limiter: never reuse the order-lock or product-cache instance.
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_SHADOW=false
API_LIMIT_REDIS_ADDRESS=redis://api-limiter:6379
API_LIMIT_REDIS_PASSWORD=replace_with_a_third_long_random_password
API_LIMIT_PREFIX=simplecard:api-limits
API_LIMIT_MAX_PEERS=5000
API_LIMIT_MEMORY_STOP_RATIO=0.75
WEBHOOK_GUARD_RPS=100
WEBHOOK_GUARD_CONCURRENCY=16
# Set exact trusted proxy addresses; for Docker include the inspected bridge gateway.
RATE_LIMIT_TRUSTED_PROXIES=127.0.0.1,::1

# Application log level. Keep INFO in production: DEBUG writes request bodies,
# SQL parameters and callback payloads into logs, which are usually shipped to a
# third-party collector. Raise to DEBUG only while troubleshooting.
LOG_LEVEL_APP=INFO
